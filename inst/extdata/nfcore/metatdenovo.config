process {
  withName: 'NFCORE_METATDENOVO:.*:MEGAHIT_INTERLEAVED' {
    cpus = 64
  }
  withName: 'NFCORE_METATDENOVO:.*:SPADES' {
    cpus   = 64
    memory = 1000.GB
  }
  withName: 'NFCORE_METATDENOVO:.*:BBMAP_INDEX' {
    cpus   = 32
    memory = 64.GB
  }
  withName: 'NFCORE_METATDENOVO:.*:BBMAP_BBNORM' {
    cpus   = 32
    memory = 200.GB
  }
  withName: 'NFCORE_METATDENOVO:.*:(MEGAHIT_INTERLEAVED|SPADES|BBMAP_BBNORM|BBMAP_INDEX|BBMAP_ALIGN|PRODIGAL_MODULE|PROKKA|EGGNOG_MAPPER|KOFAMSCAN_SCAN|EUKULELE_SEARCH)' {
    time = 30.d
  }
}
